# Vietnam Digital Banking Intelligence - Backend Configuration Template
# Duplicate this file to .env and adjust variables for your local or production environment.

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME="Vietnam Digital Banking Intelligence API"
APP_VERSION="0.1.0"
API_V1_PREFIX="/api/v1"

# Google Cloud BigQuery Configuration
GOOGLE_CLOUD_PROJECT=aiinbusinessgroup3
BIGQUERY_LOCATION=asia-southeast1

# Authentication:
# Option 1 (Local Service Account Key File): Specify absolute or relative path to JSON key
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
# Option 2 (ADC / Production Workload Identity): Leave GOOGLE_APPLICATION_CREDENTIALS unset
# to automatically authenticate via Google Application Default Credentials (ADC).
GOOGLE_APPLICATION_CREDENTIALS=

# CORS Configuration (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Cache & Connection Pool Settings
CACHE_TTL_SECONDS=3600
BIGQUERY_QUERY_TIMEOUT_SECONDS=30
